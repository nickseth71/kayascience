<!-- Skin Quiz HTML Markup -->
<div class="skin-quiz__section-wrapper main-search__skin-quiz">
  <div class="page-width">
    <div class="skin-quiz__content-wrapper">

      <!-- Skin Type Section -->
      <div class="skin-multiType__data-wrapper main-data-wrapper">
        <span>For</span>
        <div class="skin-type__content-wrapp selected-data-content">
          {% if section.settings.heading1 != blank %}
          <div class="dropdown-heading">{{ section.settings.heading1 }}</div>
          {% endif %}
          <ul class="js_col_label skin-type-data type-data-content" style="display:none;">
            {% for i in (1..5) %}
              {% capture col_label %}col_label{{ i }}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label = section.settings[label_key] | handle %}
              {% if section.settings[col_label] != blank %}
                <li data-value="{{ group_label }}">{{ section.settings[col_label] }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <!-- Product Type Section -->
      <div class="skin-productType__data-wrapper main-data-wrapper">
        <span>I'm looking for</span>
        <div class="product-type__content-wrapp selected-data-content">
          {% if section.settings.heading2 != blank %}
          <div class="dropdown-heading">{{ section.settings.heading2 }}</div>
          {% endif %}
          <ul id="product-type-select" class="js_col_list product-type-data type-data-content" style="display:none;">
            <li disabled selected>Any Product</li>
            {% for i in (1..5) %}
              {% capture col_listing %}col_list{{ i }}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label = section.settings[label_key] | handle %}
              {% for collection in section.settings[col_listing] %}
                {% assign coll_obj = collections[collection.handle] %}
                {% if coll_obj %}
                  <li value="{{ coll_obj.handle }}" data-group="{{ group_label }}">{{ coll_obj.title }}</li>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <!-- Concern Section -->
      <div class="skin-concern__data-wrapper main-data-wrapper">
        <span>that targets any concern</span>
        <div class="concern-type__content-wrapp selected-data-content">
          {% if section.settings.heading3 != blank %}
          <div class="dropdown-heading">{{ section.settings.heading3 }}</div>
          {% endif %}
          <ul id="product-concern-select" class="js_concern_list concern-type-data type-data-content" style="display:none;">
            <li disabled selected>Any Concern</li>
          </ul>
        </div>
      </div>

      <!-- Search Button -->
      {% if section.settings.search_btn_label != blank %}
      <div class="search_btn_label_wrapp">
        <div class="button js-search-products">{{ section.settings.search_btn_label }}</div>
      </div>
      {% endif %}

    </div>
  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {
  window.collectionsProductsMetafields = {
  {% for collection in collections %}
    "{{ collection.handle }}": [
      {% for product in collection.products %}
        {
          id: "{{ product.id }}",
          title: "{{ product.title | escape }}",
          metafield: {{ product.metafields.custom.concern_filter.value | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]{% unless forloop.last %},{% endunless %}
  {% endfor %}
};
  let selectedSkinType = "";
  let selectedProductType = "";
  let selectedConcern = "";

  const skinTypeSelect = document.querySelector(".js_col_label");
  const productTypeSelect = document.querySelector(".js_col_list");
  const allProductOptions = Array.from(document.querySelectorAll("li[data-group]"));
  const concernSelect = document.getElementById("product-concern-select");
  const dropdownHeadings = document.querySelectorAll('.dropdown-heading');
  const searchButton = document.querySelector('.js-search-products');

  const allProductOptionsCloned = allProductOptions.map(li => li.cloneNode(true));

  function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
  }

  function filterProductTypes(selectedGroup) {
    productTypeSelect.innerHTML = '<li disabled selected>Any Product</li>';
    allProductOptionsCloned.forEach(li => {
      if (li.dataset.group === selectedGroup) {
        productTypeSelect.appendChild(li.cloneNode(true));
      }
    });
    concernSelect.innerHTML = '<li disabled selected>Any Concern</li>';
  }

dropdownHeadings.forEach(heading => {
  heading.addEventListener('click', () => {
    const dropdown = heading.nextElementSibling;

    if (dropdown) {
      const isActive = dropdown.classList.toggle('active');
      dropdown.style.display = isActive ? "block" : "none";

      // Check if overlay already exists
      let overlayEle = document.querySelector('.quiz-overlay');

      if (isActive) {
        if (!overlayEle) {
          // Create overlay
          overlayEle = document.createElement('div');
          overlayEle.className = 'quiz-overlay';
         
   
          const closeBtn = document.createElement('button');
          closeBtn.className = 'close-overlay';
          closeBtn.innerHTML = `<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="fill-current h-auto" data-v-0e900098=""><rect y="0.00012207" width="32" height="32" fill="black"></rect><path d="M20.3043 22.0001L21.9739 20.3306L17.6696 16.0262L22 11.6958L20.3043 10.0001L15.9739 14.3306L11.6696 10.0001L10 11.6958L14.3043 16.0262L10 20.3306L11.6957 22.0001L15.9739 17.6958L20.3043 22.0001Z" fill="white"></path></svg>`;

          // Add click handler to close button
          closeBtn.addEventListener('click', () => {
            dropdown.classList.remove('active');
            dropdown.style.display = 'none';
            overlayEle.remove();
          });

          overlayEle.appendChild(closeBtn);
          document.body.appendChild(overlayEle);
        }
      } else {
        if (overlayEle) {
          overlayEle.remove();
        }
      }
    }
  });
});

  skinTypeSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI") {
      selectedSkinType = e.target.getAttribute("data-value");
      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");
      const heading = this.previousElementSibling;
      if (heading && heading.classList.contains('dropdown-heading')) {
        heading.innerText = e.target.innerText;
        heading.nextElementSibling.style.display = 'none';
        heading.nextElementSibling.classList.remove('active');
      }

        const overlayEle = document.querySelector('.quiz-overlay');
        if (overlayEle) {
          overlayEle.remove();
        }
      filterProductTypes(selectedSkinType);
    }
  });

  productTypeSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI" && !e.target.disabled) {
      selectedProductType = e.target.getAttribute("value");
      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");
      const heading = this.previousElementSibling;
      if (heading && heading.classList.contains('dropdown-heading')) {
        heading.innerText = e.target.innerText;
        heading.nextElementSibling.style.display = 'none';
        heading.nextElementSibling.classList.remove('active');
      }

      const products = window.collectionsProductsMetafields[selectedProductType] || [];
      const concernsSet = new Set();
      products.forEach(prod => {
        const meta = prod.metafield;
        if (Array.isArray(meta)) meta.forEach(val => concernsSet.add(val.trim()));
        else if (typeof meta === "string") concernsSet.add(meta.trim());
        else if (typeof meta === "object" && meta !== null) Object.values(meta).forEach(val => concernsSet.add(val.trim()));
      });

      concernSelect.innerHTML = concernsSet.size > 0 ? '<li disabled selected>Any Concern</li>' : '<li disabled selected>No concerns available</li>';
      concernsSet.forEach(concern => {
        const li = document.createElement("li");
        li.setAttribute("value", concern);
        li.textContent = concern;
        concernSelect.appendChild(li);
      });
    }
    const overlayEle = document.querySelector('.quiz-overlay');
        if (overlayEle) {
          overlayEle.remove();
        }
  });

  concernSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI" && !e.target.disabled) {
      selectedConcern = e.target.getAttribute("value");
      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");
      const heading = this.previousElementSibling;
      if (heading && heading.classList.contains('dropdown-heading')) {
        heading.innerText = e.target.innerText;
        heading.nextElementSibling.style.display = 'none';
        heading.nextElementSibling.classList.remove('active');
      }

    }
    const overlayEle = document.querySelector('.quiz-overlay');
        if (overlayEle) {
          overlayEle.remove();
        }
  });

  searchButton.addEventListener("click", function () {
    if (!selectedSkinType || !selectedProductType || !selectedConcern) {
      alert("Please select skin type, product type, and concern.");
      return;
  }

    const url = `https://kayascience.com/search?q=${encodeURIComponent(selectedProductType)}&options%5Bprefix%5D=last&filter.p.m.custom.concern_filter=${encodeURIComponent(selectedConcern)}&view=quiz-products`;
    window.location.href = url;
  });

  const firstSkinType = skinTypeSelect.querySelector("li[data-value]");
  if (firstSkinType) {
    selectedSkinType = firstSkinType.getAttribute("data-value");
    firstSkinType.classList.add("active");
    filterProductTypes(selectedSkinType);
  }
});




 function getCookie(name) {
  const value = `; ${document.cookie}`;
  const parts = value.split(`; ${name}=`);
  if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
}

window.addEventListener("DOMContentLoaded", function () {
  const skinType = getCookie("skinType");
  const productType = getCookie("productType");
  const concern = getCookie("concern");

  if (skinType) document.querySelector("#skinTypeDropdown").value = skinType;
  if (productType) document.querySelector("#productTypeDropdown").value = productType;
  if (concern) document.querySelector("#concernDropdown").value = concern;
});

</script>