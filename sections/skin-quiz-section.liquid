<!-- Skin Quiz HTML Markup -->
<div class="skin-quiz__section-wrapper">
  <div class="page-width">
    <div class="skin-quiz__content-wrapper">

      <!-- Skin Type Section -->
      <div class="skin-multiType__data-wrapper main-data-wrapper">
        <span>For</span>
        <div class="skin-type__content-wrapp selected-data-content">
          {% if section.settings.heading1 != blank %}
          <div class="dropdown-heading">{{ section.settings.heading1 }}</div>
          {% endif %}
          <ul class="js_col_label skin-type-data type-data-content" style="display:none;">
            {% for i in (1..5) %}
              {% capture col_label %}col_label{{ i }}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label = section.settings[label_key] | handle %}
              {% if section.settings[col_label] != blank %}
                <li data-value="{{ group_label }}" data-skin="{{ section.settings[col_label] }}">{{ section.settings[col_label] }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </div>

      <!-- Product Type Section -->
      <div class="skin-productType__data-wrapper main-data-wrapper">
        <span>I'm looking for</span>
        <div class="product-type__content-wrapp selected-data-content">
          {% if section.settings.heading2 != blank %}
          <div class="dropdown-heading">{{ section.settings.heading2 }}</div>
          {% endif %}
          <ul id="product-type-select" class="js_col_list product-type-data type-data-content" style="display:none;">
            {% comment %} <li disabled selected>Any Product</li> {% endcomment %}
            {% comment %} {% for i in (1..5) %}
              {% capture col_listing %}col_list{{ i }}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label = section.settings[label_key] | handle %}
              {% for collection in section.settings[col_listing] %}
                {% assign coll_obj = collections[collection.handle] %}
                {% if coll_obj %}
                  <li value="{{ coll_obj.handle }}" data-group="{{ group_label }}">{{ coll_obj.title }}</li>
                {% endif %}
              {% endfor %}
            {% endfor %} {% endcomment %}
             {% for i in (1..5) %}
                {% capture col_listing %}col_list{{ i }}{% endcapture %}
                {% capture label_key %}col_trigger{{ i }}{% endcapture %}
                {% assign group_label = section.settings[label_key] | handle %}

                {% for collection in section.settings[col_listing] %}
                  {% assign coll_obj = collections[collection.handle] %}
                  {% if coll_obj %}
                    {% assign quiz_text = coll_obj.metafields.custom.skin_quiz_text.value %}
                    <li value="{{ coll_obj.handle }}" data-value="{{ quiz_text }}" data-group="{{ group_label }}">
                      {{ quiz_text }}
                    </li>
                  {% endif %}
                {% endfor %}
              {% endfor %}

          </ul>
        </div>
      </div>

      <!-- Concern Section -->
      <div class="skin-concern__data-wrapper main-data-wrapper">
        <span>that targets</span>
        <div class="concern-type__content-wrapp selected-data-content">
          {% if section.settings.heading3 != blank %}
          <div class="dropdown-heading">{{ section.settings.heading3 }}</div>
          {% endif %}
          <ul id="product-concern-select" class="js_concern_list concern-type-data type-data-content" style="display:none;">
            {% comment %} <li disabled selected>Any Concern</li> {% endcomment %}
          </ul>
        </div>
      </div>

      <!-- Search Button -->
      {% if section.settings.search_btn_label != blank %}
      <div class="search_btn_label_wrapp">
        <div class="button js-search-products ">{{ section.settings.search_btn_label }}</div>
      </div>
      {% endif %}

    </div>
  </div>
</div>



<script>
    function setCookie(name, value, days) {
    var expires = "";
    if (days) {
      var date = new Date();
      date.setTime(date.getTime() + (days * 24*60*60*1000));
      expires = "; expires=" + date.toUTCString();
    }
    document.cookie = name + "=" + (value || "") + expires + "; path=/";
  }

{% comment %} const skinTypeElement = document.querySelector('.skin-type__content-wrapp .dropdown-heading');
const skinTypeCookie = skinTypeElement ? skinTypeElement.textContent.trim() : '';

const productTypeElement = document.querySelector('.product-type__content-wrapp .dropdown-heading');
const productTypeCookie = productTypeElement ? productTypeElement.textContent.trim() : '';

const concernTypeElement = document.querySelector('.concern-type__content-wrapp .dropdown-heading');
const concernTypeCookie = concernTypeElement ? concernTypeElement.textContent.trim() : '';


if (productTypeCookie) setCookie('product_type', productTypeCookie, 1);
if (concernTypeCookie) setCookie('concern_type', concernTypeCookie, 1); {% endcomment %}

document.addEventListener('DOMContentLoaded', () => {

  window.collectionsProductsMetafields = {
    {% for collection in collections %}
      "{{ collection.handle }}": [
        {% for product in collection.products %}
          {
            id: "{{ product.id }}",
            title: "{{ product.title | escape }}",
            metafield: {{ product.metafields.custom.concern_filter.value | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  const skinTypeSelect = document.querySelector(".js_col_label");
  const productTypeSelect = document.querySelector(".js_col_list");
  const concernSelect = document.getElementById("product-concern-select");
  const dropdownHeadings = document.querySelectorAll('.dropdown-heading');
  const searchButton = document.querySelector('.js-search-products');
  const allProductOptions = Array.from(document.querySelectorAll("li[data-group]"));
  const allProductOptionsCloned = allProductOptions.map(li => li.cloneNode(true));

  function filterProductTypes(selectedGroup) {
    selectedProductType = "";
    productTypeSelect.innerHTML = '<li disabled selected>Any Product</li>';

    allProductOptionsCloned.forEach(li => {
      if (li.dataset.group === selectedGroup) {
        const newLi = li.cloneNode(true);
        newLi.classList.remove('active');
        productTypeSelect.appendChild(newLi);
      }
    });

    const productHeading = productTypeSelect.previousElementSibling;
    if (productHeading && productHeading.classList.contains('dropdown-heading')) {
      productHeading.innerText = "Any Product";
    }

    concernSelect.innerHTML = '';
    const anyLi = document.createElement('li');
    anyLi.setAttribute("value", "");
    concernSelect.appendChild(anyLi);

    const concernHeading = concernSelect.previousElementSibling;
    if (concernHeading && concernHeading.classList.contains('dropdown-heading')) {
      concernHeading.innerText = "Any Concern";
    }

    selectedConcern = "";
  }

 dropdownHeadings.forEach(heading => {
  heading.addEventListener('click', () => {
    const dropdown = heading.nextElementSibling;

    if (dropdown) {
      const isActive = dropdown.classList.toggle('active');
      dropdown.style.display = isActive ? "block" : "none";

      // Toggle body class based on dropdown state
      if (isActive) {
        document.body.classList.add('dropdown-open');
        // Get the active dropdown element
        const activeDropdown = document.querySelector('.type-data-content.active');

        if (activeDropdown) {
          // Get its height in pixels
          const height = activeDropdown.offsetHeight;

          // Select all close-overlay elements
          const closeOverlays = document.querySelectorAll('.close-overlay');

          // Set bottom style to height + 'px'
          closeOverlays.forEach(el => {
            el.style.bottom = height + 'px';
          });
        }

      } else {
        document.body.classList.remove('dropdown-open');
      }
    }
  });
});


  skinTypeSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI") {
      selectedSkinType = e.target.getAttribute("data-value");
      selectedSkin = e.target.getAttribute("data-skin");
      setCookie('skin_type', selectedSkin, 1);
      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");

      const heading = this.previousElementSibling;
      if (heading) {
        heading.innerText = e.target.innerText;
        heading.nextElementSibling.style.display = 'none';
        heading.nextElementSibling.classList.remove('active');
        document.body.classList.remove('dropdown-open');
      }

      filterProductTypes(selectedSkinType);
    }
  });

  productTypeSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI" && !e.target.disabled) {
      selectedProductType = e.target.getAttribute("value");
      productType = e.target.getAttribute("data-value");
      setCookie('product_type', productType, 1);
      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");

      const heading = this.previousElementSibling;
      if (heading) {
        heading.innerText = e.target.innerText;
        heading.nextElementSibling.style.display = 'none';
        heading.nextElementSibling.classList.remove('active');
        document.body.classList.remove('dropdown-open');
      }

      const products = window.collectionsProductsMetafields[selectedProductType] || [];
      const concernsSet = new Set();
      products.forEach(prod => {
        const meta = prod.metafield;
        if (Array.isArray(meta)) meta.forEach(val => concernsSet.add(val.trim()));
        else if (typeof meta === "string") concernsSet.add(meta.trim());
        else if (typeof meta === "object" && meta !== null) Object.values(meta).forEach(val => concernsSet.add(val.trim()));
      });

      concernSelect.innerHTML = concernsSet.size > 0 ? '<li selected>Any Concern</li>' : '<li selected>Any Concern</li>';
      concernsSet.forEach(concern => {
        const li = document.createElement("li");
        li.setAttribute("value", concern);
        li.textContent = concern;
        concernSelect.appendChild(li);
      });

      const concernHeading = concernSelect.previousElementSibling;
      if (concernHeading) concernHeading.innerText = "Any Concern";
    }
  });

  concernSelect.addEventListener("click", function (e) {
    if (e.target.tagName === "LI" && !e.target.disabled) {
      selectedConcern = e.target.getAttribute("value");
      setCookie('concern_type', selectedConcern, 1);
      this.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      e.target.classList.add("active");

      const heading = this.previousElementSibling;
      if (heading) {
        heading.innerText = e.target.innerText;
        heading.nextElementSibling.style.display = 'none';
        heading.nextElementSibling.classList.remove('active');
        document.body.classList.remove('dropdown-open');
      }
    }
  });

  searchButton.addEventListener('click', () => {
  

    const query = selectedProductType || selectedSkinType || '';
    const concernFilter = selectedConcern && selectedConcern !== "Any Concern" ? `&filter.p.m.custom.concern_filter=${encodeURIComponent(selectedConcern)}` : '';
    const url = `https://kayascience.com/search?q=${encodeURIComponent(query)}&type=product&options%5Bprefix%5D=last${concernFilter}&view=quiz-products`;

    window.location.href = url;
  });

  // Auto-select cookie values on page load
  const skinLi = skinTypeSelect.querySelector(`li[data-value="${selectedSkinType}"]`);
  if (skinLi) {
    skinLi.classList.add("active");
    skinTypeSelect.previousElementSibling.innerText = skinLi.innerText;
    filterProductTypes(selectedSkinType);

    setTimeout(() => {
      const productLi = productTypeSelect.querySelector(`li[value="${selectedProductType}"]`);
      if (productLi) {
        productLi.classList.add("active");
        productTypeSelect.previousElementSibling.innerText = productLi.innerText;

        const products = window.collectionsProductsMetafields[selectedProductType] || [];
        const concernsSet = new Set();
        products.forEach(prod => {
          const meta = prod.metafield;
          if (Array.isArray(meta)) meta.forEach(val => concernsSet.add(val.trim()));
          else if (typeof meta === "string") concernsSet.add(meta.trim());
          else if (typeof meta === "object" && meta !== null) Object.values(meta).forEach(val => concernsSet.add(val.trim()));
        });

        concernSelect.innerHTML = concernsSet.size > 0 ? '<li selected>Any Concern</li>' : '<li selected>No concerns available</li>';
        concernsSet.forEach(concern => {
          const li = document.createElement("li");
          li.setAttribute("value", concern);
          li.textContent = concern;
          concernSelect.appendChild(li);
        });

        setTimeout(() => {
          const concernLi = concernSelect.querySelector(`li[value="${selectedConcern}"]`);
          if (concernLi) {
            concernLi.classList.add("active");
            concernSelect.previousElementSibling.innerText = concernLi.innerText;
          }
        }, 300);
      }
    }, 300);
  }

  // Close dropdowns when clicking outside
  document.addEventListener('click', function (e) {
    const isDropdownHeading = e.target.closest('.dropdown-heading');
    const isDropdownList = e.target.closest('.type-data-content');
    if (!isDropdownHeading && !isDropdownList) {
      document.querySelectorAll('.type-data-content').forEach(el => {
        el.classList.remove('active');
        el.style.display = 'none';
      });
    }
  });

  document.querySelectorAll('.close-overlay').forEach(closeBtn => {
  closeBtn.addEventListener('click', () => {
    document.body.classList.remove('dropdown-open');

    // Optionally close all dropdowns too
    document.querySelectorAll('.type-data-content').forEach(el => {
      el.classList.remove('active');
      el.style.display = 'none';
    });
  });
});



});
</script>



 


