
<div class="skin-quiz__section-wrapper">

  <div class="skin-quiz__content-wrapper page-width">
    <span>For</span>
    <div class="skin-type__content-wrapp">
      <select class="js_col_label skin-type-data">
        {% for i in (1..5) %}
          {% capture col_label  %}col_label{{i}}{% endcapture %}
           {% capture label_key %}col_trigger{{ i }}{% endcapture %}
          {% assign group_label = section.settings[label_key] | handle %}
          {% if section.settings[col_label] != blank %}
            <option value="{{ group_label }}">
              {{ section.settings[col_label] }}
            </option>
          {% endif %}
        {% endfor %}
      </select>
    </div> 

  <span>  I'm looking for</span>
    <div class="product-type__content-wrapp">
      <select id="product-type-select" class="js_col_list product-type-data">
        <option disabled selected>Any Product</option>
        {% for i in (1..5) %}
          {% capture col_listing %}col_list{{ i }}{% endcapture %}
          {% capture label_key %}col_trigger{{ i }}{% endcapture %}
          {% assign group_label = section.settings[label_key] | handle %}
          
          {% for collection in section.settings[col_listing] %}
            {% assign coll_obj = collections[collection.handle] %}
            {% if coll_obj %}
              <option value="{{ coll_obj.handle }}" data-group="{{ group_label }}">
                {{ coll_obj.title }}
              </option>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </select>
    </div>
   <span> that targets 
any concern</span>


<div class="concern-type__content-wrapp">
<select id="product-concern-select" class="js_concern_list concern-type-data">
<option disabled selected>Any Concern</option>

</select>
</div>
  </div>
</div> 

<script>
window.collectionsProductsMetafields = {
  {% for collection in collections %}
    "{{ collection.handle }}": [
      {% for product in collection.products %}
        {
          id: "{{ product.id }}",
          title: "{{ product.title | escape }}",
          metafield: "{{ product.metafields.custom.concern_filter | escape }}"
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]{% unless forloop.last %},{% endunless %}
  {% endfor %}
};

document.addEventListener("DOMContentLoaded", () => {
  const skinTypeSelect = document.querySelector(".js_col_label");
  const productTypeSelect = document.querySelector(".js_col_list");
  const allOptions = Array.from(productTypeSelect.querySelectorAll("option[data-group]"));
  const concernSelect = document.getElementById("product-concern-select");

  // Filter product types based on selected skin type
  function filterProductTypes(selectedGroup) {
    productTypeSelect.innerHTML = '<option disabled selected>Any Product</option>';
    allOptions.forEach(option => {
      if (option.dataset.group === selectedGroup) {
        productTypeSelect.appendChild(option.cloneNode(true));
      }
    });
    // Reset concerns when product type list changes
    concernSelect.innerHTML = '<option disabled selected>Any Concern</option>';
  }

  skinTypeSelect.addEventListener("change", function () {
    filterProductTypes(this.value);
  });

  // If skin type pre-selected on page load
  if (skinTypeSelect.value) {
    filterProductTypes(skinTypeSelect.value);
  }

  // Populate concerns based on selected product type (collection)
  productTypeSelect.addEventListener("change", function() {
    const selectedCollection = this.value;
    const products = window.collectionsProductsMetafields[selectedCollection] || [];

    // Get unique metafield values
    const concernsSet = new Set();
        products.forEach(prod => {
        if (prod.metafield && prod.metafield.trim() !== "") {
            try {
            const arr = JSON.parse(prod.metafield);
            if (Array.isArray(arr)) {
                arr.forEach(item => concernsSet.add(item));
            } else {
                concernsSet.add(prod.metafield);
            }
            } catch(e) {
            concernsSet.add(prod.metafield);
            }
        }
        });

    concernSelect.innerHTML = '<option disabled selected>Any Concern</option>';

    if (concernsSet.size === 0) {
      concernSelect.innerHTML = '<option disabled selected>No concerns available</option>';
    } else {
      concernsSet.forEach(concern => {
        const option = document.createElement("option");
        option.value = concern;
        option.textContent = concern;
        concernSelect.appendChild(option);
      });
    }
  });
});
</script>


