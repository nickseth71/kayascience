<div class="skin-quiz__section-wrapper">
  <div class="page-width">
    <div class="skin-quiz__content-wrapper">
      <div class="skin-multiType__data-wrapper main-data-wrapper">
        <span>For</span>
        <div class="skin-type__content-wrapp selected-data-content">
          {% if section.settings.heading1 != blank %}
          <div class="dropdown-heading">
            {{ section.settings.heading1 }}
          <svg width="16" height="12" viewBox="0 0 12 7" xmlns="http://www.w3.org/2000/svg" class="" data-v-0e900098=""><path d="M9.60002 0L5.5 4.10001L1.40003 6.31809e-06L2.95639e-05 1.40001L5.5 7.00001L11.1 1.5L9.60002 0Z"></path></svg>
          </div>
          {% endif %}
          <ul class="js_col_label skin-type-data type-data-content" style="display:none;">
            {% for i in (1..5) %}
              {% capture col_label  %}col_label{{i}}{% endcapture %}
              {% capture label_key %}col_trigger{{ i }}{% endcapture %}
              {% assign group_label = section.settings[label_key] | handle %}
              {% if section.settings[col_label] != blank %}
                <li data-value="{{ group_label }}" >
                  {{ section.settings[col_label] }}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div> 
      </div>
      <div class="skin-productType__data-wrapper main-data-wrapper">
      <span>I'm looking for</span>
      <div class="product-type__content-wrapp selected-data-content">
        {% if section.settings.heading2 != blank %}
        <div class="dropdown-heading">
          {{ section.settings.heading2 }}
        <svg width="16" height="12" viewBox="0 0 12 7" xmlns="http://www.w3.org/2000/svg" class="" data-v-0e900098=""><path d="M9.60002 0L5.5 4.10001L1.40003 6.31809e-06L2.95639e-05 1.40001L5.5 7.00001L11.1 1.5L9.60002 0Z"></path></svg>
       </div>
        {% endif %}
        <ul id="product-type-select" class="js_col_list product-type-data type-data-content" style="display:none;">
          <li disabled selected>Any Product</li>
          {% for i in (1..5) %}
            {% capture col_listing %}col_list{{ i }}{% endcapture %}
            {% capture label_key %}col_trigger{{ i }}{% endcapture %}
            {% assign group_label = section.settings[label_key] | handle %}
            {% for collection in section.settings[col_listing] %}
              {% assign coll_obj = collections[collection.handle] %}
              {% if coll_obj %}
                <li value="{{ coll_obj.handle }}" data-group="{{ group_label }}">
                  {{ coll_obj.title }}
                </li>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </ul>
      </div>
      </div>

      <div class="skin-concern__data-wrapper  main-data-wrapper">
          <span>that targets any concern</span>
          <div class="concern-type__content-wrapp selected-data-content">
            {% if section.settings.heading3 != blank %}
            <div class="dropdown-heading">
              {{ section.settings.heading3 }}
                <svg width="16" height="12" viewBox="0 0 12 7" xmlns="http://www.w3.org/2000/svg" class="" data-v-0e900098=""><path d="M9.60002 0L5.5 4.10001L1.40003 6.31809e-06L2.95639e-05 1.40001L5.5 7.00001L11.1 1.5L9.60002 0Z"></path></svg>
            </div>
            {% endif %}
            <ul id="product-concern-select" class="js_concern_list concern-type-data type-data-content" style="display:none;">
              <li disabled selected>Any Concern</li>
            </ul>
          </div>
      </div>
      {% if section.settings.search_btn_label != blank %}
        <div class="search_btn_label_wrapp">
          <div class="button js-search-products" data-product-type="" data-concern-type="">
            {{ section.settings.search_btn_label }}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>


<script>
// Utility to get cookie by name
function getCookie(name) {
  const value = `; ${document.cookie}`;
  const parts = value.split(`; ${name}=`);
  if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
}

// Read cookies
const savedSkin = getCookie('skinType');
const savedProduct = getCookie('productType');
const savedConcern = getCookie('concern');

// Track current selected skin type (important for cookie saving)
let selectedSkinType = savedSkin || ""; // Initialize here

// Restore saved selections from cookies if available
if (savedSkin) {
  const skinItem = document.querySelector(`.js_col_label li[data-value="${savedSkin}"]`);
  if (skinItem) {
    skinItem.click();
    selectedSkinType = savedSkin;
  }
}

if (savedProduct) {
  const productItem = document.querySelector(`.js_col_list li[value="${savedProduct}"]`);
  if (productItem) productItem.click();
}

if (savedConcern) {
  const concernItem = document.querySelector(`#product-concern-select li[value="${savedConcern}"]`);
  if (concernItem) concernItem.click();
}

// If no cookies, default to first skin type
if (!savedSkin) {
  const firstSkinType = skinTypeSelect.querySelector("li[data-value]");
  if (firstSkinType) {
    const selectedGroup = firstSkinType.getAttribute("data-value");
    selectedSkinType = selectedGroup; // Now it's defined
    filterProductTypes(selectedGroup);
    firstSkinType.click();
  }
}

// Update selectedSkinType when user picks one
skinTypeSelect.addEventListener("click", function (e) {
  if (e.target.tagName === "LI") {
    selectedSkinType = e.target.getAttribute("data-value");
  }
});

// Set cookies on search button click
document.querySelector('.js-search-products').addEventListener("click", function () {
  if (!selectedProductType || !selectedConcern || !selectedSkinType) return;

  // Set cookies (1-day lifespan)
  document.cookie = `skinType=${encodeURIComponent(selectedSkinType)}; path=/; max-age=86400`;
  document.cookie = `productType=${encodeURIComponent(selectedProductType)}; path=/; max-age=86400`;
  document.cookie = `concern=${encodeURIComponent(selectedConcern)}; path=/; max-age=86400`;

  // Redirect
  const url = `https://kayascience.com/search?q=${encodeURIComponent(selectedProductType)}&options%5Bprefix%5D=last&filter.p.m.custom.concern_filter=${encodeURIComponent(selectedConcern)}&view=quiz-products`;
  window.location.href = url;
});

</script>



